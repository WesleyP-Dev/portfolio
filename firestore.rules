rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner() {
      return request.auth != null && request.auth.uid == '6EXAaVCxYqXnn0QEDOAgSfXoECq1';
    }

    function validPortfolio() {
      let doc = request.resource.data;
      let content = doc.content;
      return doc.keys().hasOnly(['content', 'revision'])
        && doc.revision is int
        && content is map
        && content.keys().hasOnly(['nome', 'introducao', 'sobre', 'redes', 'curriculo', 'tecnologias', 'projetos', 'certificados'])
        && content.nome is string && content.introducao is string && content.curriculo is string
        && content.sobre is map && content.sobre.titulo is string && content.sobre.descricao is string
        && content.redes is map && content.redes.linkedin is string && content.redes.github is string
        && content.tecnologias is list && content.tecnologias.size() <= 80
        && content.projetos is list && content.projetos.size() <= 80
        && (!('certificados' in content) || (content.certificados is list && content.certificados.size() <= 80));
    }

    // Imagens enviadas pelo painel (WebP/PNG/JPEG comprimidas no navegador, até ~950 KB cada).
    match /imagens/{id} {
      allow get: if true;
      allow create: if owner()
        && request.resource.data.keys().hasOnly(['dados', 'tipo', 'tamanho', 'criado'])
        && request.resource.data.dados is bytes
        && request.resource.data.dados.size() <= 950000
        && request.resource.data.tipo in ['image/webp', 'image/png', 'image/jpeg']
        && request.resource.data.tamanho == request.resource.data.dados.size()
        && request.resource.data.criado == request.time;
      allow delete: if owner();
    }

    match /publico/portfolio {
      allow get: if true;
      allow create: if owner() && validPortfolio() && request.resource.data.revision == 1;
      allow update: if owner() && validPortfolio() && request.resource.data.revision == resource.data.revision + 1;
    }
  }
}
